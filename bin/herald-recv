#!/usr/bin/env bash
# herald-recv — block until the next inbound Telegram message, then print it.
#
# Usage:
#   text=$(herald-recv)              # print the message text
#   json=$(herald-recv --json)       # print the raw JSON envelope
#   herald-recv --timeout 60         # give up after 60s (exit 1)
#
# Env:
#   HERALD_SOCKET   Unix socket path (default: /tmp/herald.sock)
#
# Note: this opens a fresh connection per call. Messages arriving while no
# connection is open are NOT buffered (herald has no persistence). For a
# durable listener that never misses a message, hold one persistent
# connection instead (see bin/herald-pi-bridge).
set -euo pipefail

SOCKET="${HERALD_SOCKET:-/tmp/herald.sock}"
TIMEOUT=0
JSON=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --timeout) TIMEOUT="$2"; shift 2 ;;
    --timeout=*) TIMEOUT="${1#--timeout=}"; shift ;;
    --json) JSON=1; shift ;;
    -h|--help)
      printf 'Usage: %s [--timeout <seconds>] [--json]\n' "$(basename "$0")" >&2
      exit 2 ;;
    *) printf 'herald-recv: unknown option: %s\n' "$1" >&2; exit 2 ;;
  esac
done

if [[ ! -S "$SOCKET" ]]; then
  printf 'herald-recv: daemon socket not found at %s (is herald running?)\n' "$SOCKET" >&2
  exit 1
fi

read_one() { socat -u "UNIX-CONNECT:$SOCKET" - | head -n1; }

if [[ "$TIMEOUT" -gt 0 ]]; then
  line=$(timeout "$TIMEOUT" bash -c "$(declare -f read_one); SOCKET='$SOCKET' read_one") || {
    printf 'herald-recv: timed out after %ss\n' "$TIMEOUT" >&2
    exit 1
  }
else
  line=$(read_one)
fi

[[ -n "$line" ]] || { printf 'herald-recv: connection closed with no message\n' >&2; exit 1; }

if [[ "$JSON" -eq 1 ]]; then
  printf '%s\n' "$line"
else
  jq -r '.text // empty' <<<"$line"
fi
