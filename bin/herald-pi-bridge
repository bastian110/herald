#!/usr/bin/env bash
# herald-pi-bridge — drive the pi agent from Telegram via herald.
#
# Built on `herald recv --follow` and `herald send` (no socat/jq). pi's
# conversation persists across messages via an isolated session dir; "/new"
# resets the agent context and returns the closed conversation id; "/continue ID"
# resumes a previous conversation; "/reload" reloads pi resources.
#
# Env:
#   HERALD_SOCKET          socket path (default: /tmp/herald.sock)
#   HERALD_PI_SESSION_DIR  pi session storage (default: ~/.herald/pi-sessions)
#   HERALD_PI_WORKDIR      working dir for pi (default: $HOME)
#   HERALD_PI_LOCK_FILE    single-run lock path (default: /tmp/herald-pi-bridge.lock)
#   HERALD_PI_ACTIVE_SESSION_FILE active pi session id marker (default: $HERALD_PI_SESSION_DIR/.herald-active-session)
#   HERALD_WHISPER_ROOT    whisper.cpp install root (default: ~/Projects/oss/whisper.cpp)
#   HERALD_WHISPER_MODEL   whisper model path (default: $HERALD_WHISPER_ROOT/models/ggml-base.bin)
#   HERALD_PI_VOICE_LANG   whisper language (default: auto)
#   HERALD_PI_PARSE_MODE   Telegram format for pi replies (default: HTML uses rich messages; empty disables)
#
# Telegram photos are downloaded and passed to pi as @image file arguments.
set -uo pipefail

# systemd user services start with a minimal PATH that omits the herald binary
# (repo dir) and user-installed tools like pi (~/.local/bin). Prepend them so
# both resolve.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$SCRIPT_DIR/..:$HOME/.local/bin:$HOME/.local/go/bin:$HOME/go/bin:$PATH"

S="${HERALD_PI_SESSION_DIR:-$HOME/.herald/pi-sessions}"
W="${HERALD_PI_WORKDIR:-$HOME}"
L="${HERALD_PI_LOCK_FILE:-/tmp/herald-pi-bridge.lock}"
WHISPER_ROOT="${HERALD_WHISPER_ROOT:-$HOME/Projects/oss/whisper.cpp}"
WHISPER_MODEL="${HERALD_WHISPER_MODEL:-$WHISPER_ROOT/models/ggml-base.bin}"
WHISPER_CLI="$WHISPER_ROOT/build/bin/whisper-cli"
VOICE_LANG="${HERALD_PI_VOICE_LANG:-auto}"
PI_PARSE_MODE="${HERALD_PI_PARSE_MODE:-HTML}"
ACTIVE_SESSION_FILE="${HERALD_PI_ACTIVE_SESSION_FILE:-$S/.herald-active-session}"
NEW_SESSION_SENTINEL="__new__"
mkdir -p "$S"

if command -v flock >/dev/null 2>&1; then
  exec 9>"$L"
  if ! flock -n 9; then
    echo "herald-pi-bridge: another bridge is already running (lock: $L)" >&2
    exit 0
  fi
else
  LOCK_DIR="${L}.d"
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    echo "herald-pi-bridge: another bridge is already running (lock: $LOCK_DIR)" >&2
    exit 0
  fi
  trap 'rmdir "$LOCK_DIR"' EXIT INT TERM
fi

telegram_get_file_path() {
  local file_id="$1"
  curl -fsSL "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/getFile?file_id=${file_id}" \
    | python3 -c 'import json,sys; data=json.load(sys.stdin); print(data.get("result", {}).get("file_path", ""))'
}

download_telegram_file() {
  local file_id="$1"
  local output="$2"
  local file_path
  file_path="$(telegram_get_file_path "$file_id")"
  if [[ -z "$file_path" ]]; then
    return 1
  fi
  curl -fsSL "https://api.telegram.org/file/bot${TELEGRAM_BOT_TOKEN}/${file_path}" -o "$output"
}

telegram_file_suffix() {
  local file_id="$1"
  local fallback="$2"
  local file_path suffix
  file_path="$(telegram_get_file_path "$file_id")"
  suffix="${file_path##*.}"
  if [[ -n "$file_path" && "$suffix" != "$file_path" && ${#suffix} -le 5 ]]; then
    printf '.%s' "$suffix"
  else
    printf '.%s' "$fallback"
  fi
}

transcribe_voice() {
  local input="$1"
  local tmp_wav
  tmp_wav="$(mktemp /tmp/herald-voice-XXXXXX.wav)"
  if [[ ! -x "$WHISPER_CLI" || ! -f "$WHISPER_MODEL" ]]; then
    echo "whisper unavailable: $WHISPER_CLI / $WHISPER_MODEL" >&2
    rm -f "$tmp_wav"
    return 1
  fi
  if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "ffmpeg unavailable" >&2
    rm -f "$tmp_wav"
    return 1
  fi
  if ! ffmpeg -y -i "$input" -ar 16000 -ac 1 -c:a pcm_s16le "$tmp_wav" >/dev/null 2>&1; then
    echo "ffmpeg decode failed: $input" >&2
    rm -f "$tmp_wav"
    return 1
  fi
  if [[ "$VOICE_LANG" == "auto" ]]; then
    "$WHISPER_CLI" -m "$WHISPER_MODEL" -f "$tmp_wav" -l auto -nt -np
  else
    "$WHISPER_CLI" -m "$WHISPER_MODEL" -f "$tmp_wav" -l "$VOICE_LANG" -nt -np
  fi
  local rc=$?
  rm -f "$tmp_wav"
  return $rc
}

session_id_from_file() {
  local session_file="$1"
  python3 - "$session_file" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    with path.open(encoding="utf-8") as handle:
        header = json.loads(handle.readline())
except Exception:
    print("")
    raise SystemExit(0)
print(header.get("id", ""))
PY
}

latest_session_file() {
  python3 - "$S" <<'PY'
import sys
from pathlib import Path

session_dir = Path(sys.argv[1])
files = [path for path in session_dir.glob("*.jsonl") if path.is_file()]
if files:
    print(max(files, key=lambda path: path.stat().st_mtime))
PY
}

latest_session_id() {
  local session_file
  session_file="$(latest_session_file)"
  [[ -n "$session_file" ]] || return 0
  session_id_from_file "$session_file"
}

resolve_session_id() {
  local query="$1"
  python3 - "$S" "$query" <<'PY'
import json
import sys
from pathlib import Path

session_dir = Path(sys.argv[1])
query = sys.argv[2].strip()
if not query:
    raise SystemExit(1)

matches: list[str] = []
for path in session_dir.glob("*.jsonl"):
    try:
        with path.open(encoding="utf-8") as handle:
            header = json.loads(handle.readline())
    except Exception:
        continue
    session_id = str(header.get("id", ""))
    if session_id == query or session_id.startswith(query):
        matches.append(session_id)

matches = sorted(set(matches))
if len(matches) == 1:
    print(matches[0])
    raise SystemExit(0)
if len(matches) > 1:
    print("\n".join(matches[:5]))
    raise SystemExit(2)
raise SystemExit(1)
PY
}

active_session_id() {
  local session_id
  if [[ -f "$ACTIVE_SESSION_FILE" ]]; then
    session_id="$(head -n 1 "$ACTIVE_SESSION_FILE" 2>/dev/null || true)"
    if [[ "$session_id" == "$NEW_SESSION_SENTINEL" ]]; then
      return 0
    fi
    if [[ -n "$session_id" ]] && resolve_session_id "$session_id" >/dev/null 2>&1; then
      printf '%s\n' "$session_id"
      return 0
    fi
  fi
  session_id="$(latest_session_id)"
  if [[ -n "$session_id" ]]; then
    printf '%s\n' "$session_id" > "$ACTIVE_SESSION_FILE"
    printf '%s\n' "$session_id"
  fi
}

mark_new_session() {
  printf '%s\n' "$NEW_SESSION_SENTINEL" > "$ACTIVE_SESSION_FILE"
}

set_active_session_id() {
  local session_id="$1"
  printf '%s\n' "$session_id" > "$ACTIVE_SESSION_FILE"
}

refresh_active_session_id_after_run() {
  local previous_session_id="$1"
  local previous_session_file="$2"
  local session_file session_id

  session_file="$(latest_session_file)"
  [[ -n "$session_file" ]] || return 0
  if [[ -z "$previous_session_id" && "$session_file" == "$previous_session_file" ]]; then
    return 0
  fi

  session_id="$(session_id_from_file "$session_file")"
  [[ -n "$session_id" ]] || return 0
  set_active_session_id "$session_id"
}

html_escape() {
  python3 -c 'import html, sys; print(html.escape(sys.stdin.read(), quote=False), end="")'
}

send_pi_reply() {
  local chat_id="$1"
  local reply="$2"
  if [[ -n "$PI_PARSE_MODE" ]]; then
    herald send --chat-id "$chat_id" --parse-mode "$PI_PARSE_MODE" "$reply" \
      || herald send --chat-id "$chat_id" "$reply"
    return
  fi
  herald send --chat-id "$chat_id" "$reply"
}

QUEUE_DIR="${HERALD_PI_QUEUE_DIR:-/tmp/herald-pi-bridge.queue}"
RUN_PID_FILE="${HERALD_PI_RUN_PID_FILE:-/tmp/herald-pi-bridge.pi.pid}"
if [[ -z "$QUEUE_DIR" || "$QUEUE_DIR" == "/" ]]; then
  echo "herald-pi-bridge: unsafe queue dir: $QUEUE_DIR" >&2
  exit 1
fi
mkdir -p "$QUEUE_DIR"
find "$QUEUE_DIR" -mindepth 1 -maxdepth 1 \( -name 'task-*' -o -name '.task-*' -o -name generation \) -exec rm -rf {} + 2>/dev/null || true
rm -f "$RUN_PID_FILE"
printf '0\n' > "$QUEUE_DIR/generation"

current_generation() {
  cat "$QUEUE_DIR/generation" 2>/dev/null || printf '0\n'
}

bump_generation() {
  local generation
  generation="$(( $(current_generation) + 1 ))"
  printf '%s\n' "$generation" > "$QUEUE_DIR/generation"
}

pi_is_running() {
  [[ -f "$RUN_PID_FILE" ]] && kill -0 "$(cat "$RUN_PID_FILE")" 2>/dev/null
}

stop_current_pi() {
  local pid
  if ! pi_is_running; then
    rm -f "$RUN_PID_FILE"
    return
  fi
  pid="$(cat "$RUN_PID_FILE")"
  pkill -TERM -P "$pid" 2>/dev/null || true
  kill -TERM "$pid" 2>/dev/null || true
  sleep 0.2
  pkill -KILL -P "$pid" 2>/dev/null || true
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$RUN_PID_FILE"
}

clear_pending_tasks() {
  find "$QUEUE_DIR" -mindepth 1 -maxdepth 1 -type d -name 'task-*' -exec rm -rf {} + 2>/dev/null || true
}

next_task_dir() {
  find "$QUEUE_DIR" -mindepth 1 -maxdepth 1 -type d -name 'task-*' 2>/dev/null | sort | head -n 1
}

run_pi_task() {
  local task_dir="$1"
  local chat_id prompt task_generation out reply rc pi_pid session_id session_file_before
  local tmp_images=()
  local pi_args=(--session-dir "$S")

  if [[ ! -f "$task_dir/chat_id" || ! -f "$task_dir/prompt" || ! -f "$task_dir/generation" ]]; then
    rm -rf "$task_dir"
    return
  fi

  chat_id="$(cat "$task_dir/chat_id")"
  prompt="$(cat "$task_dir/prompt")"
  task_generation="$(cat "$task_dir/generation")"
  if [[ -f "$task_dir/images" ]]; then
    local image_path
    while IFS= read -r image_path; do
      [[ -n "$image_path" ]] || continue
      tmp_images+=("$image_path")
    done < "$task_dir/images"
  fi
  if [[ "$task_generation" != "$(current_generation)" ]]; then
    rm -f "${tmp_images[@]}"
    rm -rf "$task_dir"
    return
  fi

  out="$(mktemp /tmp/herald-pi-output-XXXXXX.log)"
  session_file_before="$(latest_session_file)"
  session_id="$(active_session_id)"
  if [[ -n "$session_id" ]]; then
    pi_args+=(--session "$session_id")
  fi

  if [[ ${#tmp_images[@]} -gt 0 ]]; then
    local pi_files=()
    local tmp_image
    for tmp_image in "${tmp_images[@]}"; do
      pi_files+=("@$tmp_image")
    done
    (cd "$W" && printf '%s' "$prompt" | pi "${pi_args[@]}" -p "${pi_files[@]}" >"$out" 2>&1) &
    pi_pid=$!
  else
    (cd "$W" && printf '%s' "$prompt" | pi "${pi_args[@]}" -p >"$out" 2>&1) &
    pi_pid=$!
  fi

  printf '%s\n' "$pi_pid" > "$RUN_PID_FILE"
  if [[ "$task_generation" != "$(current_generation)" ]]; then
    pkill -TERM -P "$pi_pid" 2>/dev/null || true
    kill -TERM "$pi_pid" 2>/dev/null || true
    wait "$pi_pid" 2>/dev/null || true
    rm -f "$RUN_PID_FILE" "${tmp_images[@]}" "$out"
    rm -rf "$task_dir"
    return
  fi

  wait "$pi_pid"
  rc=$?
  rm -f "$RUN_PID_FILE" "${tmp_images[@]}"

  if [[ "$task_generation" == "$(current_generation)" ]]; then
    refresh_active_session_id_after_run "$session_id" "$session_file_before"
    reply="$(cat "$out")"
    [[ -n "$reply" ]] || reply="(pi: réponse vide)"
    if [[ $rc -ne 0 ]]; then
      reply="⚠️ pi exited with code $rc

$reply"
    fi
    send_pi_reply "$chat_id" "$reply"
  fi

  rm -f "$out"
  rm -rf "$task_dir"
}

enqueue_pi_reply() {
  local chat_id="$1"
  local prompt="$2"
  shift 2
  local tmp_images=("$@")
  local task_dir task_tmp task_id was_busy tmp_image

  was_busy=0
  if pi_is_running || [[ -n "$(next_task_dir)" ]]; then
    was_busy=1
  fi

  task_id="$(date +%s%N)-$$-$RANDOM"
  task_tmp="$QUEUE_DIR/.task-$task_id"
  task_dir="$QUEUE_DIR/task-$task_id"
  mkdir "$task_tmp"
  printf '%s\n' "$chat_id" > "$task_tmp/chat_id"
  printf '%s' "$prompt" > "$task_tmp/prompt"
  printf '%s\n' "$(current_generation)" > "$task_tmp/generation"
  : > "$task_tmp/images"
  for tmp_image in "${tmp_images[@]}"; do
    [[ -n "$tmp_image" ]] || continue
    printf '%s\n' "$tmp_image" >> "$task_tmp/images"
  done
  mv "$task_tmp" "$task_dir"

  if [[ $was_busy -eq 1 ]]; then
    herald send --chat-id "$chat_id" "📥 Message ajouté à la file Pi."
  fi
}

process_queue() {
  local task_dir
  while true; do
    task_dir="$(next_task_dir)"
    if [[ -z "$task_dir" ]]; then
      sleep 0.2
      continue
    fi
    run_pi_task "$task_dir"
  done
}

process_queue &
queue_worker_pid=$!

cleanup_done=0
cleanup() {
  if [[ $cleanup_done -eq 1 ]]; then
    return
  fi
  cleanup_done=1
  if [[ -n "${queue_worker_pid:-}" ]]; then
    kill "$queue_worker_pid" 2>/dev/null || true
    wait "$queue_worker_pid" 2>/dev/null || true
  fi
  stop_current_pi
}
handle_shutdown() {
  cleanup
  exit 0
}
trap cleanup EXIT
trap handle_shutdown INT TERM

echo "herald-pi-bridge: listening (sessions: $S, queue: $QUEUE_DIR)" >&2

herald recv --follow --json | while IFS= read -r raw; do
  [[ -n "$raw" ]] || continue
  eval "$(python3 - "$raw" <<'PY'
import json, shlex, sys
m = json.loads(sys.argv[1])
fields = {
    'KIND': m.get('kind', 'text') or 'text',
    'TEXT': m.get('text', '') or '',
    'CHAT_ID': str(m.get('chat_id', '') or ''),
    'FILE_ID': m.get('file_id', '') or '',
    'FILE_IDS': '\n'.join(m.get('file_ids') or []),
    'MIME_TYPE': m.get('mime_type', '') or '',
}
for k, v in fields.items():
    print(f"{k}={shlex.quote(v)}")
PY
)"

  prompt="$TEXT"
  if [[ "$KIND" == "voice" ]]; then
    if [[ -z "${TELEGRAM_BOT_TOKEN:-}" ]]; then
      herald send --chat-id "$CHAT_ID" "⚠️ Vocal reçu, mais TELEGRAM_BOT_TOKEN manque côté bridge."
      continue
    fi
    tmp_voice="$(mktemp /tmp/herald-voice-XXXXXX.ogg)"
    tmp_err="$(mktemp /tmp/herald-whisper-XXXXXX.log)"
    if ! download_telegram_file "$FILE_ID" "$tmp_voice"; then
      rm -f "$tmp_voice" "$tmp_err"
      herald send --chat-id "$CHAT_ID" "⚠️ Échec téléchargement du vocal Telegram."
      continue
    fi
    transcript=""
    if ! transcript="$(transcribe_voice "$tmp_voice" 2>"$tmp_err")"; then
      rm -f "$tmp_voice"
      err_msg="$(tr '\n' ' ' < "$tmp_err")"
      rm -f "$tmp_err"
      [[ -n "$err_msg" ]] || err_msg="échec transcription"
      herald send --chat-id "$CHAT_ID" "⚠️ Transcription vocal impossible: $err_msg"
      continue
    fi
    rm -f "$tmp_voice" "$tmp_err"
    if [[ -z "$transcript" ]]; then
      herald send --chat-id "$CHAT_ID" "⚠️ Échec transcription du vocal."
      continue
    fi
    if [[ -n "$prompt" ]]; then
      prompt="$prompt

Transcription du vocal Telegram:
$transcript"
    else
      prompt="Transcription du vocal Telegram:
$transcript"
    fi
  fi

  tmp_images=()
  if [[ "$KIND" == "image" || "$KIND" == "photo" ]]; then
    if [[ -z "${TELEGRAM_BOT_TOKEN:-}" ]]; then
      herald send --chat-id "$CHAT_ID" "⚠️ Image reçue, mais TELEGRAM_BOT_TOKEN manque côté bridge."
      continue
    fi
    image_file_ids="$FILE_IDS"
    if [[ -z "$image_file_ids" ]]; then
      image_file_ids="$FILE_ID"
    fi
    while IFS= read -r image_file_id; do
      [[ -n "$image_file_id" ]] || continue
      suffix="$(telegram_file_suffix "$image_file_id" "jpg")"
      tmp_image="$(mktemp "/tmp/herald-image-XXXXXX${suffix}")"
      if ! download_telegram_file "$image_file_id" "$tmp_image"; then
        rm -f "${tmp_images[@]}" "$tmp_image"
        herald send --chat-id "$CHAT_ID" "⚠️ Échec téléchargement d'une image Telegram."
        continue 2
      fi
      tmp_images+=("$tmp_image")
    done <<< "$image_file_ids"
    if [[ -z "$prompt" ]]; then
      prompt="Image Telegram jointe. Décris-la ou réponds à partir de son contenu."
    fi
  fi

  [[ -n "$prompt" || ${#tmp_images[@]} -gt 0 ]] || continue
  if [[ "$prompt" == "/reload" ]]; then
    rm -f "${tmp_images[@]}"
    bump_generation
    clear_pending_tasks
    stop_current_pi
    herald send --chat-id "$CHAT_ID" "♻️ Pi bridge rechargé. Les prochains messages relanceront pi avec les ressources à jour."
    if command -v systemctl >/dev/null 2>&1; then
      systemctl --user restart herald-pi-bridge >/dev/null 2>&1 &
    fi
    continue
  fi
  if [[ "$prompt" == "/new" ]]; then
    rm -f "${tmp_images[@]}"
    bump_generation
    clear_pending_tasks
    stop_current_pi
    closed_session_id="$(active_session_id)"
    mark_new_session
    if [[ -n "$closed_session_id" ]]; then
      send_pi_reply "$CHAT_ID" "🔄 Nouvelle conversation pi.
Conversation fermée : <code>$closed_session_id</code>
Reprendre : <code>/continue $closed_session_id</code>"
    else
      send_pi_reply "$CHAT_ID" "🔄 Nouvelle conversation pi. Aucune conversation précédente trouvée."
    fi
    continue
  fi
  if [[ "$prompt" == "/continue" || "$prompt" == /continue\ * ]]; then
    rm -f "${tmp_images[@]}"
    continue_arg="${prompt#/continue}"
    continue_arg="${continue_arg# }"
    if [[ -z "$continue_arg" || "$continue_arg" == "$prompt" ]]; then
      send_pi_reply "$CHAT_ID" "Usage : <code>/continue ID_CONVERSATION</code>"
      continue
    fi
    resolved_session_id="$(resolve_session_id "$continue_arg")"
    resolve_rc=$?
    if [[ $resolve_rc -ne 0 ]]; then
      case $resolve_rc in
        2) send_pi_reply "$CHAT_ID" "⚠️ ID ambigu. Utilise un ID plus long." ;;
        *)
          escaped_continue_arg="$(printf '%s' "$continue_arg" | html_escape)"
          send_pi_reply "$CHAT_ID" "⚠️ Conversation introuvable : <code>$escaped_continue_arg</code>"
          ;;
      esac
      continue
    fi
    bump_generation
    clear_pending_tasks
    stop_current_pi
    set_active_session_id "$resolved_session_id"
    send_pi_reply "$CHAT_ID" "↩️ Conversation reprise : <code>$resolved_session_id</code>"
    continue
  fi
  enqueue_pi_reply "$CHAT_ID" "$prompt" "${tmp_images[@]}"
done
